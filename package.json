    "@types/jest": "29.5.14",
    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.2.2",
    "@types/react-dom": "^19.2.4",
    "@types/supercluster": "^7.1.3",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.8.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:types": "supabase gen types typescript --linked > src/types/database.ts",
    "test": "jest",
    "test:ci": "jest --ci --runInBand",
    "release:check": "node scripts/release-config.cjs",
    "postinstall": "node scripts/patch-query-string.cjs",
    "test:e2e": "playwright test",
    "preflight": "bash scripts/preflight-check.sh",
    "auth:status": "node --env-file=.env scripts/check-auth-settings.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    },
    "query-string": {
      "decode-uri-component": "0.5.0"
    }
  }
