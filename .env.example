# ─────────────────────────────────────────────────────────────
# Guardians — environment variables
# Copy this file to `.env` and fill in your own values.
# Variables prefixed with EXPO_PUBLIC_ are inlined into the app bundle
# (safe for client-side keys like the Supabase anon key & Maps keys).
# ─────────────────────────────────────────────────────────────

# Supabase — from your project's API settings (https://app.supabase.com)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Google Maps — create keys in Google Cloud Console with the
# "Maps SDK for Android" and "Maps SDK for iOS" enabled.
# You can use the same key for both if its restrictions allow it.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=YOUR-ANDROID-MAPS-KEY
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=YOUR-IOS-MAPS-KEY

# Sentry (optional) — error reporting via the observability façade. Leave blank
# to run in safe no-op mode. Client Keys (DSN) in sentry.io → Project Settings.
EXPO_PUBLIC_SENTRY_DSN=

# Sentry project wiring for sourcemap upload during EAS builds — the
# @sentry/react-native/expo config plugin in app.config.ts is only enabled when
# BOTH of these are set (organization slug + project slug from sentry.io).
# Not EXPO_PUBLIC_: they are read at build time only, never bundled.
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN (Org Auth Token, https://sentry.io/settings/auth-tokens/) is
# required for Hermes sourcemap upload during builds. Do NOT add it here and
# never prefix it with EXPO_PUBLIC_ — set it as an EAS secret instead:
#   eas secret:create --name SENTRY_AUTH_TOKEN --value <token> --type string

# AI features — master switch for AI UI in the app. Keep false until the
# server-side ai-* edge functions are deployed. Set to exactly `true` to enable.
EXPO_PUBLIC_AI_ENABLED=false

# Anthropic (Claude) API key — SERVER-SIDE ONLY. This is NOT an EXPO_PUBLIC_
# variable: it must never be bundled into the app. Set it as a Supabase secret so
# only the ai-* edge functions can read it:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=

# Voyage AI embeddings key — SERVER-SIDE ONLY, same rules as above (Anthropic
# has no embeddings API, so vector search uses Voyage):
#   supabase secrets set VOYAGE_API_KEY=pa-...
# Required by ai-embed, ai-reid, ai-lost-match, ai-kb-ingest and
# ai-rescue-copilot; without it each returns 503 and its feature stays inert.
VOYAGE_API_KEY=

# EAS (Expo Application Services) — only needed for cloud builds.
# Run `eas init` to generate this, then paste it here.
EAS_PROJECT_ID=
