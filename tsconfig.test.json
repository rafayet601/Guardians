{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["jest", "node"],
    "noEmit": true
  },
  "include": ["src/__tests__/**/*.ts", "src/__tests__/**/*.tsx"]
}
